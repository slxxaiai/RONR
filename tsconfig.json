{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@ronr/contracts": ["packages/contracts/src/index.ts"],
      "@ronr/providers": ["packages/providers/src/index.ts"],
      "@ronr/agents": ["packages/agents/src/index.ts"],
      "@ronr/db": ["packages/db/src/index.ts"],
      "@ronr/core": ["packages/core/src/index.ts"],
      "@ronr/web/*": ["apps/web/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
